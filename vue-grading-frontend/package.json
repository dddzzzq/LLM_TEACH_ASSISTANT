{
  "name": "vue-grading-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "allowScripts": {
    "esbuild": true
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/services/*.test.js",
    "format": "prettier --write src *.js index.html package.json .prettierrc.json",
    "format:check": "prettier --check src *.js index.html package.json .prettierrc.json"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "dompurify": "^3.3.3",
    "marked": "^17.0.5",
    "vue": "^3.4.29",
    "vue-router": "^4.3.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "prettier": "3.6.2",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  }
}
