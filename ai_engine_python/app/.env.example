# Fill in your DeepSeek key locally. Empty allows local model/service checks;
# cloud grading and Agent chat require a valid key.
DEEPSEEK_API_KEY=

# Resolved relative to the repository root, NOT the current working directory.
# D:\dzq\LLM_TEACH_ASSISTANT + ../models = D:\dzq\models
TEACH_MODELS_DIR=../models

BACKEND_ADDR=127.0.0.1:8000
FRONTEND_HOST=127.0.0.1
REDIS_ADDR=127.0.0.1:6379
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_VERSION=4.1.0
AI_GRPC_ADDR=127.0.0.1:50051
AI_GRPC_BIND=127.0.0.1:50051
RPA_CONTROL_URL=http://127.0.0.1:8765
RPA_CONTROL_PORT=8765
RPA_MAX_TASKS=2
GRADING_WORKERS=2
AI_GRPC_WORKERS=4
OCR_DEVICE=cpu
OCR_WORKERS=2
OCR_CPU_THREADS=6
OCR_TASK_TIMEOUT_SECONDS=120
AGENT_MODEL=deepseek-chat
PAGE_AGENT_MODEL=deepseek-chat

# The bootstrap writes the database DSN to a separate ignored runtime file.
# Override DATABASE_DSN here if you use an existing database.
# JWT_ACCESS_SECRET/JWT_REFRESH_SECRET are generated and persisted at first start.
